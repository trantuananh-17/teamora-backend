NODE_ENV=development
PORT=8080

API_BASE_URL=http://localhost:8080
APP_BASE_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# openssl rand -base64 32
BETTER_AUTH_SECRET=

DATABASE_PATH=./data/teamora.db

# Dev points at the maildev container from ../docker-compose.yml.
# Leave SMTP_HOST empty to turn mail off entirely.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Teamora <no-reply@teamora.local>
