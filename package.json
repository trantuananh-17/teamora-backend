{
	"name": "teamora-backend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=22 <25"
	},
	"scripts": {
		"dev:api": "tsx watch src/main.api.ts",
		"build": "tsup",
		"start:api": "node dist/main.api.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/db/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"seed:admin": "tsx src/db/seed-admin.ts",
		"seed:demo": "tsx src/db/seed-demo.ts"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"better-auth>vitest": "5",
				"@better-auth/core>@better-auth/utils": "0.5"
			}
		}
	},
	"dependencies": {
		"@better-auth/core": "1.7.2",
		"@hono/node-server": "^1.19.17",
		"@libsql/client": "^0.18.0",
		"better-auth": "1.7.2",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"exceljs": "^4.4.0",
		"hono": "^4.13.7",
		"nodemailer": "^10.0.3",
		"zod": "^4.6.1"
	},
	"devDependencies": {
		"@types/node": "^22.20.2",
		"@types/nodemailer": "^8.0.1",
		"drizzle-kit": "^0.31.10",
		"tsup": "^8.5.1",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"vitest": "^5.0.0"
	}
}
